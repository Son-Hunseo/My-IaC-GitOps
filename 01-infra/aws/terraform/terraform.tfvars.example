# 한국어 주석: 이 파일은 커밋 가능한 예시입니다. AWS access key나 secret key를 여기에 저장하지 마십시오.

aws_region = "ap-northeast-2"

default_tags = {
  Project = "My-GitAIOps"
}

cluster_name    = "gitops-eks-dev"
cluster_version = "1.35"

vpc_cidr             = "10.40.0.0/16"
public_subnet_cidrs  = ["10.40.0.0/20", "10.40.16.0/20"]
private_subnet_cidrs = ["10.40.32.0/20", "10.40.48.0/20"]
availability_zones   = ["ap-northeast-2a", "ap-northeast-2c"]

single_nat_gateway      = true
endpoint_public_access  = true
endpoint_private_access = true
public_access_cidrs     = ["관리자 공인 IP/32"]

node_group_name    = "default-workers"
node_instance_types = ["t3.medium"]
node_desired_size  = 2
node_min_size      = 2
node_max_size      = 2
node_disk_size_gb  = 50
node_capacity_type = "ON_DEMAND"

additional_node_policy_arns = []

# 비워 두면 AWS가 cluster version에 맞는 기본 add-on version을 선택합니다.
ebs_csi_addon_version = null

# 비워 두면 arn:aws:secretsmanager:<region>:<account-id>:secret:<cluster_name>-* 로 제한합니다.
external_secrets_secret_arns = []

# 고객 관리형 KMS key로 암호화한 secret을 읽는 경우 key ARN을 추가합니다.
external_secrets_kms_key_arns = []
