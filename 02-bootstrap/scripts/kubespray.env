# kubespray 버전 고정 파일입니다. 모든 스크립트가 이 값을 읽습니다.
# 버전을 올릴 때는 이 파일만 바꾸고 kubespray-sample/ 을 새 태그 기준으로 다시 복사하세요.

# 고정할 kubespray 릴리스 태그입니다.
KUBESPRAY_VERSION="${KUBESPRAY_VERSION:-v2.31.0}"

# kubespray 저장소 주소입니다.
KUBESPRAY_REPO="${KUBESPRAY_REPO:-https://github.com/kubernetes-sigs/kubespray.git}"

# kubespray를 클론할 위치입니다.
# 저장소 밖(리눅스 홈)에 두는 이유:
#   1) 저장소를 가볍게 유지하고 업스트림 코드를 커밋하지 않기 위해
#   2) kubespray의 일부 파일 경로가 매우 길어 Windows 파일시스템(/mnt/c 포함)에서
#      "Filename too long" 오류로 체크아웃이 실패하기 때문
KUBESPRAY_DIR="${KUBESPRAY_DIR:-$HOME/.kubespray/$KUBESPRAY_VERSION}"

# kubespray가 요구하는 Ansible 버전을 격리해서 설치할 virtualenv 위치입니다.
KUBESPRAY_VENV="${KUBESPRAY_VENV:-$HOME/.kubespray/venv-$KUBESPRAY_VERSION}"
